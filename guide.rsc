d:["$","aside",null,{"className":"seasonal-food-note","children":[["$","p",null,{"className":"guide-kicker","children":"Eat the season"}],["$","p",null,{"children":["Look for persimmons, mikan, roasted sweet potatoes (",["$","i",null,{"children":"yaki-imo"}],"), chestnuts, new-harvest rice, and the start of crab and oyster season. Grab late Shine Muscat grapes if you see them; toward month’s end, watch for winter’s first premium strawberries."]}]]}]
e:["$","section",null,{"className":"guide-section","id":"plan","aria-labelledby":"plan-title","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"Before you go"}],["$","h2",null,{"id":"plan-title","children":"A little planning pays off"}],["$","p",null,{"children":"Japan rewards advance planning more than almost anywhere we have traveled—mostly because the good stuff books up."}]]}],["$","div",null,{"className":"planning-disclosures","children":[[["$","details","Two to three months out",{"open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"01"}],"Two to three months out"]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Passport, flights, hotels",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Passport, flights, hotels"}],null]}],["$","p",null,{"children":"Check that your passport is valid through the trip; book flights and hotels, including at least one night at a ryokan."}],null]}],["$","li","Dinner reservations",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Dinner reservations"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Start with the restaurants you care about. Windows typically open 30–60 days ahead; find each opening date and set a reminder."}],null]}],["$","li","Timed attractions",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Timed attractions"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Book teamLab, Shibuya Sky, the Sagano Romantic Train, Rurikoin, and Universal Studios as their windows open."}],null]}]]}]]}],["$","details","One month out",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"02"}],"One month out"]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Shinkansen seats",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Shinkansen seats"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Reservations generally open one month ahead and advance tickets are cheaper. Choose the Mt. Fuji side and reserve oversized-luggage seats if needed; wrestle with the Japanese booking site from your couch, not a station."}],null]}],["$","li","Visit Japan Web",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Visit Japan Web"}],null]}],["$","p",null,{"children":"Enter immigration and customs information and get an arrival QR code; it saves real time at the airport."}],["$","a",null,{"className":"guide-text-link","href":"https://services.digital.go.jp/en/visit-japan-web/","aria-label":"$undefined","children":["Set up Visit Japan Web"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}]]}]]}],["$","details","One to two weeks out",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"03"}],"One to two weeks out"]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Data",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Data"}],null]}],["$","p",null,{"children":"Set up an eSIM (we use Airalo) unless your phone plan includes international data."}],null]}],["$","li","Suica",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Suica"}],null]}],["$","p",null,{"children":"Use this tap-to-pay transit card for trains, convenience stores, Starbucks, groceries, and more. iPhone users can add Suica in Apple Wallet (Wallet → + → Transit Card → Suica); most US Android phones cannot run Mobile Suica, so pick up a physical Welcome Suica at the airport."}],null]}],["$","li","Useful apps",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Useful apps"}],null]}],["$","p",null,{"children":"Download Google Maps, Google Translate with the Japanese offline pack, and the GO taxi app."}],null]}],["$","li","Cards",{"children":[["$","div",null,{"className":"tagged-list__heading","children":["$L18",null]}],"$L19",null]}]]}]]}]],"$L1a"]}],"$L1b"]}]
f:["$","section",null,{"className":"guide-section","id":"know","aria-labelledby":"know-title","children":[["$","div",null,{"className":"guide-visual-heading","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"The essentials"}],["$","h2",null,{"id":"know-title","children":"Know before you go"}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-know.webp","srcSet":"/assets/guide-know-480.webp 480w, /assets/guide-know-960.webp 960w, /assets/guide-know.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"Pedestrians crossing a neon-lit Tokyo street on a rainy evening.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","ul",null,{"className":"tagged-list tagged-list--columns","children":[["$","li","A little Japanese goes a long way",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"A little Japanese goes a long way"}],null]}],["$","p",null,{"children":"Very few people speak English, and even those who do may prefer not to. Learn a handful of phrases and use Google Translate when needed. Most signs are in English and tourist areas are well prepared for foreigners."}],null]}],["$","li","Follow the rules",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Follow the rules"}],null]}],["$","p",null,{"children":"Japan is very rule-oriented: people even wait at an empty red crosswalk. Be on time—not early or late—and be polite, like a guest in someone else’s home. Foreigners get a free pass on most things."}],null]}],["$","li","Expect a price dichotomy",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Expect a price dichotomy"}],null]}],["$","p",null,{"children":"Most things feel remarkably cheap compared with the US, while taxis, fancy fruit, Kobe beef, and nice hotels can get fairly pricey. Overall, your money goes surprisingly far."}],null]}],["$","li","Shop tax-free; carry your passport",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Shop tax-free; carry your passport"}],null]}],["$","p",null,{"children":"Most stores return the tax at the register, but you need your actual physical passport. Bring it on days when you may do real shopping."}],null]}],["$","li","Almost no trash cans",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Almost no trash cans"}],null]}],["$","p",null,{"children":"Carry your trash until you find one. Konbini—7-Eleven, Lawson, and FamilyMart—are reliable places to dispose of it. Somehow the country remains spotless."}],null]}],["$","li","Two restaurant quirks",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Two restaurant quirks"}],null]}],["$","p",null,{"children":"Water rarely appears unless you ask, and it comes in a tiny cup. If you take milk or cream in coffee, ask for extra; the default pour is comically small."}],null]}]]}]]}]
10:["$","section",null,{"className":"guide-section","id":"transport","aria-labelledby":"transport-title","children":[["$","div",null,{"className":"guide-visual-heading guide-visual-heading--reverse","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"Getting around"}],["$","h2",null,{"id":"transport-title","children":"Trains first, taxis strategically"}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-transport.webp","srcSet":"/assets/guide-transport-480.webp 480w, /assets/guide-transport-960.webp 960w, /assets/guide-transport.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"A modern shinkansen waiting at a station platform.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Google Maps is your friend",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Google Maps is your friend"}],null]}],["$","p",null,{"children":"It is accurate for navigating Japan and tells you which numbered station exit to use—which matters more than you would think."}],null]}],["$","li","Giant stations need buffer time",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Giant stations need buffer time"}],null]}],["$","p",null,{"children":"Major stations are extremely large and genuinely confusing, sometimes with 50 numbered exits and multiple separate train systems. A transfer can mean leaving one system and entering another without going outdoors. Leave time to get lost once or twice."}],null]}],["$","li","Book the big train trips at home",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Book the big train trips at home"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Buy city-to-city tickets such as Tokyo → Kyoto online before the trip; it is cheaper and avoids Japanese booking sites on vacation. Buy or tap Suica for local subways and short hops as you go."}],null]}],["$","li","Ride the shinkansen at least once",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Ride the shinkansen at least once"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"It is the way to make big hops such as Tokyo–Kyoto. Reserve ahead if the Mt. Fuji view matters to you; November’s clear-view odds are excellent."}],null]}],["$","li","Kyoto ↔ Osaka, the scenic way",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Kyoto ↔ Osaka, the scenic way"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"The plush Aoniyoshi sightseeing train runs among Kyoto, Nara, and Osaka and is worth taking for the experience. Book it in advance."}],null]}],["$","li","Taxis in moderation",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Taxis in moderation"}],null]}],["$","p",null,{"children":"They are readily available but pricey, so default to walking and trains and use taxis strategically to save time and feet. GO works well. Drivers’ GPS can be charmingly old-school, making rides longer than Google estimates, and there is no Uber-style rideshare—every ride is an official taxi."}],null]}]]}],["$","div",null,{"className":"transport-figures","children":[["$","figure",null,{"className":"seat-figure","children":[["$","div",null,{"className":"seat-diagram","aria-hidden":"true","children":[["$","span",null,{"children":"Tokyo"}],["$","span",null,{"children":"← left side"}],["$","b",null,{"children":["富士山",["$","br",null,{}],"Mt. Fuji"]}],["$","span",null,{"children":"right side →"}],["$","span",null,{"children":"Kyoto / Osaka"}]]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"The Fuji side of the shinkansen:"}]," sit on the right side heading to Kyoto/Osaka and the left side heading back to Tokyo. Reserve if the view matters."]}]]}],"$L1c"]}]]}]
11:["$","section",null,{"className":"guide-section","id":"experiences","aria-labelledby":"experiences-title","children":[["$","div",null,{"className":"guide-visual-heading","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"Only-in-Japan favorites"}],["$","h2",null,{"id":"experiences-title","children":"Experiences worth building around"}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-experiences.webp","srcSet":"/assets/guide-experiences-480.webp 480w, /assets/guide-experiences-960.webp 960w, /assets/guide-experiences.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"A traditional Japanese tea ceremony setting with a kettle and cups.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","ul",null,{"className":"tagged-list tagged-list--columns","children":[["$","li","Stay at a ryokan for a night",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Stay at a ryokan for a night"}],null]}],["$","p",null,{"children":"A traditional inn is worth choosing over the familiar international brands for one night. Styles and prices vary widely; dinner and breakfast are generally included and often spectacular multi-course affairs. Many have onsen."}],null]}],["$","li","Go to an onsen",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Go to an onsen"}],null]}],["$","p",null,{"children":"This natural hot-spring bath is one of our favorite experiences in Japan, and you can visit one at our wedding hotel. Public baths are gender-separated, everyone is naked, and phones stay away. Private baths can be rented by the hour or built into nicer ryokan rooms. Find an outdoor rotenburo for steaming water in cool November air. For a public bath, watch an etiquette video beforehand—there are real rules and no phone inside to check them."}],null]}],["$","li","Get a wet head spa",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Get a wet head spa"}],null]}],["$","p",null,{"children":"Japan has spas devoted entirely to the head and scalp. Dry and wet versions are both great, but choose wet if you must pick. The temperature-change wizardry is among the most relaxing things we have experienced; a good one costs a decent chunk and is 100% worth it."}],null]}],["$","li","Wander a giant Don Quijote",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Wander a giant Don Quijote"}],null]}],["$","p",null,{"children":"Try a large Tokyo or Osaka branch: Amazon in real life, with nearly everything, usually cheap, and tax-free buying in-store. Even navigating it without buying anything is an experience."}],null]}],["$","li","Animal cafés",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Animal cafés"}],null]}],["$","p",null,{"children":"Order a drink and spend time with the residents. We have enjoyed cat cafés; dog, hedgehog, mini pig, otter, and owl versions also exist if you go looking."}],null]}]]}]]}]
12:["$","section",null,{"className":"guide-section","id":"eat","aria-labelledby":"eat-title","children":[["$","div",null,{"className":"guide-split-heading","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"Eating & drinking"}],["$","h2",null,{"id":"eat-title","children":"Your guide to picking restaurants"}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-food.webp","srcSet":"/assets/guide-food-480.webp 480w, /assets/guide-food-960.webp 960w, /assets/guide-food.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"Sushi chefs preparing an omakase meal across a wooden counter.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","figure",null,{"className":"tabelog-scale","children":[["$","figcaption",null,{"children":[["$","strong",null,{"children":"How to read Tabelog"}],"Japan’s Yelp-like ratings use a tougher scale than US apps. Our first 4.0+ meal became one of the most memorable of our lives."]}],["$","ol",null,{"children":[["$","li",null,{"children":[["$","b",null,{"children":"3.0"}],["$","span",null,{"children":"good"}]]}],["$","li",null,{"children":[["$","b",null,{"children":"3.5"}],["$","span",null,{"children":"excellent"}]]}],["$","li",null,{"children":[["$","b",null,{"children":"4.0"}],["$","span",null,{"children":"exceptional, rare, and genuinely difficult to book"}]]}]]}]]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Restaurants specialize",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Restaurants specialize"}],null]}],["$","p",null,{"children":"Menus are not diverse in the US sense: you choose what you are eating when you choose the restaurant. Many are course-based. The quality bar runs high from vending-machine-ticket ramen counters to Michelin stars."}],null]}],["$","li","Reserve what matters most",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Reserve what matters most"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Top places combine tiny seating counts with huge demand, confusing sites, and fierce competition; popular no-reservation spots mean a line. Lock in dinners for the food you care most about, then leave other meals for casual finds. We prioritize teppanyaki, yakitori, tonkatsu, and yakiniku because we love meat—make the list your own."}],null]}],["$","li","Try kaiten sushi",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Try kaiten sushi"}],null]}],["$","p",null,{"children":"Order on a tablet and watch your choices arrive by conveyor belt. It sounds gimmicky; the sushi is actually really good. Omakase is the fancy chef-decides-everything alternative, but can overwhelm anyone who does not want a large range of fish."}],null]}],["$","li","Look for the Kobe stamp",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Look for the Kobe stamp"}],null]}],["$","p",null,{"children":"Kobe is a specific wagyu from a specific breed, not a synonym for all Japanese beef. It is pricey and the best steak either of us has had. Omi and Matsusaka are other premium types—we have tried all three and found them fairly indistinguishable—but Kobe is easiest on a tourist route. Teppanyaki is ideal. Look for the official stamp: a small golden cow statue proving legitimacy."}],null]}],["$","li","Take Japanese fruit seriously",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Take Japanese fruit seriously"}],null]}],["$","p",null,{"children":"Fruit is sold in grades; the top ones are pricey and worth trying once. Find beautifully packed fruit in supermarkets, department-store basements, and stations. Premium strawberries arrive toward winter at roughly ¥1,000–1,500 for six (about $10). We can barely eat strawberries at home now. Also try Shine Muscat grapes, muskmelon, apples, and mikan."}],null]}],"$L1d","$L1e"]}]]}]
13:["$","section",null,{"className":"guide-section city-chapter","id":"tokyo","aria-labelledby":"tokyo-title","children":[["$","div",null,{"className":"city-chapter__intro","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"City 01"}],["$","h2",null,{"id":"tokyo-title","children":"Tokyo"}],["$","p",null,{"children":"Tokyo’s scale makes NYC feel small. A single neighborhood can fill half or all of a day, so do not check off everything—pick what sounds like you."}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-tokyo.webp","srcSet":"/assets/guide-tokyo-480.webp 480w, /assets/guide-tokyo-960.webp 960w, /assets/guide-tokyo.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"Tokyo Tower rising above the city skyline.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","div",null,{"className":"city-chapter__content","children":[["$","div",null,{"children":[["$","h3",null,{"className":"guide-subheading","children":"Things to see · in no particular order"}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Shibuya & Shibuya Crossing",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Shibuya & Shibuya Crossing"}],null]}],["$","p",null,{"children":"Explore the neighborhood and see the crossing at full chaos. The huge Tower Records supplies ’90s nostalgia."}],null]}],["$","li","Shibuya Sky",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Shibuya Sky"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"The open-air deck above the crossing reveals Tokyo’s immense scale. Buy early; popular slots sell out. Arrive about an hour before sunset—mid-afternoon in November—for daylight, sunset, and night."}],null]}],["$","li","Harajuku",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Harajuku"}],null]}],["$","p",null,{"children":"A great neighborhood for shopping and restaurants."}],null]}],["$","li","Shinjuku",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Shinjuku"}],["$","span",null,{"className":"guide-tag","children":"Night"}]]}],["$","p",null,{"children":"Go when the neon and nightlife are fully lit."}],null]}],["$","li","Senso-ji Temple (Asakusa)",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Senso-ji Temple (Asakusa)"}],null]}],["$","p",null,{"children":"Arrive in late afternoon while the shopping street is open, then stay for the illuminated temple and pagoda."}],null]}],["$","li","teamLab Planets",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"teamLab Planets"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"The immersive art exhibit lives up to its Instagram fame and takes about two hours; tickets are required in advance. The newer teamLab Borderless also gets great reports, though we have not done it yet."}],null]}],["$","li","Tokyo Metropolitan Government Building",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tokyo Metropolitan Government Building"}],["$","span",null,{"className":"guide-tag","children":"Walk-in"}]]}],["$","p",null,{"children":"A free Shinjuku-area observation deck with no advance ticket. We think Shibuya Sky is much better, but the price is right."}],null]}],["$","li","Imperial Palace",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Imperial Palace"}],null]}],["$","p",null,{"children":"Skip the formal tours; walk the grounds and enormous park when the light is good."}],null]}],["$","li","Tokyo Station",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tokyo Station"}],null]}],["$","p",null,{"children":"Enormous enough to be a destination, with lots of shopping inside and a facade beautifully lit at night."}],null]}],"$L1f","$L20","$L21","$L22","$L23"]}]]}],"$L24"]}]]}]
14:["$","section",null,{"className":"guide-section city-chapter","id":"kyoto","aria-labelledby":"kyoto-title","children":[["$","div",null,{"className":"city-chapter__intro city-chapter__intro--reverse","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"City 02"}],["$","h2",null,{"id":"kyoto-title","children":"Kyoto"}],["$","p",null,{"children":"The former capital is Japan’s historical heart: temples, shrines, and old streets. The supply is effectively endless, so research and choose what calls to you. The single biggest tip: reach major sights as early as possible. Crowds get intense."}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-kyoto.webp","srcSet":"/assets/guide-kyoto-480.webp 480w, /assets/guide-kyoto-960.webp 960w, /assets/guide-kyoto.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"Kinkaku-ji framed by red autumn leaves beneath a clear blue sky in Kyoto.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","aside",null,{"className":"kyoto-viewing","aria-labelledby":"viewing-title","children":[["$","p",null,{"className":"guide-kicker","children":"The November move"}],["$","h3",null,{"id":"viewing-title","children":"Reserve early-morning and evening temple viewings"}],["$","p",null,{"children":["Kyoto is one of the world’s most famous foliage destinations, so peak ",["$","i",null,{"children":"koyo"}],"brings everyone and their mother. Many temples, parks, and shrines offer special reserved early-morning and evening viewings; evening sessions are often illuminated and avoid the general crowds. They require booking ahead. We would do this every single time: look up which places offer special viewings this fall and grab spots."]}]]}],["$","div",null,{"className":"city-chapter__content","children":[["$","div",null,{"children":[["$","h3",null,{"className":"guide-subheading","children":"Things to see · in no particular order"}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Gion",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Gion"}],null]}],["$","p",null,{"children":"The famous historic district is wonderful for photos and shopping. Nearby Yasaka Pagoda looks unreal at sunrise and sunset."}],null]}],["$","li","Kiyomizu-dera Temple",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Kiyomizu-dera Temple"}],["$","span",null,{"className":"guide-tag","children":"Early"}]]}],["$","p",null,{"children":"A hillside temple with a huge wooden stage and great surrounding streets. It gets especially busy, so go early."}],null]}],["$","li","Fushimi Inari",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Fushimi Inari"}],["$","span",null,{"className":"guide-tag","children":"Early"}]]}],["$","p",null,{"children":"Thousands of red gates and an optional full hike to the top; you do not have to finish it. Go early."}],null]}],["$","li","Kinkaku-ji",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Kinkaku-ji"}],null]}],["$","p",null,{"children":"The Golden Pavilion, surrounded by a beautiful park."}],null]}],["$","li","Arashiyama",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Arashiyama"}],["$","span",null,{"className":"guide-tag","children":"Early"}]]}],["$","p",null,{"children":"Spend a day 30–45 minutes from the center with the bamboo forest, river and bridge, and monkey park. Get an early start."}],null]}],["$","li","Sagano Romantic Sightseeing Train",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Sagano Romantic Sightseeing Train"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"A scenic Arashiyama train that runs most of the year but not winter, especially gorgeous in fall. Book when tickets release and try for open-air car 5, “The Rich”—no glass, and naturally everyone wants it."}],null]}],"$L25","$L26"]}]]}],"$L27"]}]]}]
15:["$","section",null,{"className":"guide-section city-chapter","id":"osaka","aria-labelledby":"osaka-title","children":[["$","div",null,{"className":"city-chapter__intro","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"City 03"}],["$","h2",null,{"id":"osaka-title","children":"Osaka"}],["$","p",null,{"children":"Think smaller-scale Tokyo, famous for food and personality. There is not a ton of traditional sightseeing, so one or two days is typical—but it is fantastic for eating your way through and catching up on shopping."}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-osaka.webp","srcSet":"/assets/guide-osaka-480.webp 480w, /assets/guide-osaka-960.webp 960w, /assets/guide-osaka.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"Neon billboards reflected in the Dotonbori canal at night in Osaka.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","div",null,{"className":"city-chapter__content","children":[["$","div",null,{"children":[["$","h3",null,{"className":"guide-subheading","children":"Things to do · in no particular order"}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Dotonbori",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Dotonbori"}],null]}],["$","p",null,{"children":"The famous neon canal district with the Glico running man sign from all the photos. Endless food. There’s also a huge Don Quijote here if you haven’t experienced one yet."}],null]}],["$","li","Tsutenkaku & around",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tsutenkaku & around"}],null]}],["$","p",null,{"children":"Similar retro-neon energy, different sights, and lots more food."}],null]}],["$","li","Umeda Sky Building",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Umeda Sky Building"}],null]}],["$","p",null,{"children":"The best city view in Osaka. Tickets are needed but easy to get."}],null]}],["$","li","A food tour",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"A food tour"}],null]}],["$","p",null,{"children":"Osaka is the right city for sampling many dishes and meeting other travelers."}],null]}],["$","li","teamLab Botanical Garden",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"teamLab Botanical Garden"}],["$","span",null,{"className":"guide-tag","children":"Optional"}]]}],["$","p",null,{"children":"The outdoor cousin of Tokyo’s exhibits. Pick Tokyo if choosing one; worthwhile if you love them."}],null]}],["$","li","Universal Studios Japan",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Universal Studios Japan"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"We have not visited, but it is famous for Super Nintendo World if you are into that. Tickets in advance."}],null]}]]}]]}],["$","aside",null,{"className":"osaka-restaurant","aria-labelledby":"torisen-title","children":[["$","p",null,{"className":"guide-kicker","children":"Where to eat"}],["$","h3",null,{"id":"torisen-title","children":["Yakitori Torisen ",["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Amazing yakitori with a great chef; a reservation is required. This is the place we would go back to first."}]]}]]}]]}]
16:["$","section",null,{"className":"guide-section","id":"more-japan","aria-labelledby":"more-title","children":[["$","div",null,{"className":"guide-visual-heading guide-visual-heading--reverse","children":[["$","header",null,{"className":"guide-section__header","children":[["$","p",null,{"className":"guide-kicker","children":"Day trips & farther afield"}],["$","h2",null,{"id":"more-title","children":"More Japan"}]]}],["$","figure",null,{"className":"guide-photo","children":["$","img",null,{"src":"/assets/guide-more-japan.webp","srcSet":"/assets/guide-more-japan-480.webp 480w, /assets/guide-more-japan-960.webp 960w, /assets/guide-more-japan.webp 1200w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 34rem","width":1200,"height":800,"alt":"A deer beneath a torii gate surrounded by autumn leaves.","loading":"lazy","fetchPriority":"auto","decoding":"async"}]}]]}],["$","ul",null,{"className":"tagged-list tagged-list--columns","children":[["$","li","Hakone",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Hakone"}],null]}],["$","p",null,{"children":"Possible as a Tokyo day trip, but we stayed one night and recommend it. This mountain area has onsen, Fuji views, lovely ryokan, and the “Hakone loop”: cable car, ropeway, and lake crossing on a pirate ship—yes, a pirate ship. November combines foliage with clear-air Fuji views."}],null]}],["$","li","Nara",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Nara"}],null]}],["$","p",null,{"children":"An easy Kyoto or Osaka day trip. Free-roaming deer literally bow when fed; animal lovers will delight, and the park also has beautiful temples."}],null]}],["$","li","Kobe",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Kobe"}],["$","span",null,{"className":"guide-tag","children":"Optional"}]]}],["$","p",null,{"children":"We day-tripped from Osaka specifically to eat Kobe beef in Kobe and valued the story. Real Kobe beef exists in every major city, so skip this unless the idea means something to you."}],null]}],["$","li","Hiroshima & Miyajima",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Hiroshima & Miyajima"}],null]}],["$","p",null,{"children":"Hiroshima has a deeply moving museum dedicated to the WWII atomic bombing. Nearby Miyajima has beautiful temples and the famous “floating” torii gate."}],null]}],["$","li","Hokkaido",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Hokkaido"}],null]}],["$","p",null,{"children":"Japan’s northern island offers mountains, incredible food, world-class winter skiing, and summer flower fields—a good destination almost any time of year."}],null]}],["$","li","Snow monkeys (Nagano)",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Snow monkeys (Nagano)"}],null]}],["$","p",null,{"children":"A winter-specific Tokyo day trip to wild monkeys lounging in natural hot springs. Experience warns us: the approach is a 45-minute hike on snowy, slippery trails, so bring real footwear. Highly prefer an organized Tokyo bus tour over the train-and-bus combination."}],null]}]]}],["$","div",null,{"className":"return-seasons","children":[["$","header",null,{"children":[["$","p",null,{"className":"guide-kicker","children":"If you come back"}],["$","h3",null,{"children":"Japan by season"}]]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Spring · March/April",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Spring · March/April"}],null]}],["$","p",null,{"children":"Cherry blossoms make this the most popular season, but many travelers cross the world and miss them: bloom windows are short, regional, hard to predict, and worsening with climate change. Arrive near the estimate and stay flexible enough to chase the bloom. Plum blossoms can start in mid-February and be just as beautiful with a fraction of the crowds."}],null]}],"$L28","$L29"]}]]}]]}]
17:["$","footer",null,{"className":"site-footer","children":["$","div",null,{"className":"site-footer__inner","children":[["$","p",null,{"children":[["$","time",null,{"dateTime":"2026-11-13","children":"November 13"}],"–",["$","time",null,{"dateTime":"2026-11-15","children":"15, 2026"}]," · Yamanashi, Japan"]}],["$","nav",null,{"aria-label":"Footer navigation","children":["$","ul",null,{"children":[["$","li","/",{"children":["$","a",null,{"href":"/","aria-current":"$undefined","children":"Home"}]}],["$","li","/schedule",{"children":["$","a",null,{"href":"/schedule","aria-current":"$undefined","children":"Schedule"}]}],["$","li","/guide",{"children":["$","a",null,{"href":"/guide","aria-current":"page","children":"Guide to Japan"}]}],["$","li","/registry",{"children":["$","a",null,{"href":"/registry","aria-current":"$undefined","children":"Registry"}]}],["$","li","/rsvp",{"children":["$","a",null,{"href":"/rsvp","aria-current":"$undefined","children":"RSVP"}]}]]}]}]]}]}]
18:["$","h3",null,{"children":"Cards"}]
19:["$","p",null,{"children":"Bring a Visa or Mastercard with no foreign transaction fees. Plenty of card-taking places do not accept AMEX."}]
1a:["$","details",null,{"children":[["$","summary",null,{"children":[["$","span",null,{"children":"04"}],"What to pack"]}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Walking shoes",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Walking shoes"}],null]}],["$","p",null,{"children":"Your comfiest pair: 15,000–20,000 steps a day is completely normal."}],null]}],["$","li","Layers",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Layers"}],null]}],["$","p",null,{"children":"Pack for crisp days and chilly mornings and evenings; a light jacket beats a heavy coat."}],null]}],["$","li","Coin pouch",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Coin pouch"}],null]}],["$","p",null,{"children":"Coins pile up and remain useful for vending machines, lockers, and all sorts of small purchases."}],null]}],["$","li","Water bottle",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Water bottle"}],null]}],["$","p",null,{"children":"Restaurant water pours tend to be tiny, so a reusable bottle earns its luggage space."}],null]}],["$","li","Plug check",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Plug check"}],null]}],["$","p",null,{"children":"US two-prong Type A plugs work with Japan’s 100V outlets; three-prong plugs need a cheap adapter."}],null]}],["$","li","No tipping",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"No tipping"}],null]}],["$","p",null,{"children":"Leave the tipping habit at home. Great service is the standard, and trying to tip mostly creates confusion."}],null]}]]}]]}]
1b:["$","aside",null,{"className":"cash-note","aria-labelledby":"cash-title","children":[["$","p",null,{"className":"guide-kicker","children":"Cash"}],["$","h3",null,{"id":"cash-title","children":"Carry yen even when cards work"}],["$","p",null,{"children":"Souvenir shops, snack stands, and street-food counters can still be cash-only. ¥10,000–20,000 per person per week is a good baseline; the exchange rate has been very favorable to the dollar for the last few years. If you run low, ATMs inside any 7-Eleven accept US cards."}]]}]
1c:["$","aside",null,{"className":"luggage-callout","aria-labelledby":"luggage-title","children":[["$","p",null,{"className":"guide-kicker","children":"The luggage move"}],["$","h3",null,{"id":"luggage-title","children":"Send the suitcase. Carry one night."}],["$","p",null,{"children":"Hotels can forward bags overnight to your next hotel for a reasonable fee. It is a game-changer because stations and trains are not built for large suitcases. Shinkansen oversized-luggage seats must be reserved specifically. Forward the big bag and keep a small overnight bag with you."}]]}]
1d:["$","li","Try kakigori",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Try kakigori"}],null]}],["$","p",null,{"children":"Japanese shaved ice is way better than versions we have tried elsewhere. It comes in every flavor; green tea is the classic."}],null]}]
1e:["$","li","Explore Japanese whisky by the pour",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Explore Japanese whisky by the pour"}],null]}],["$","p",null,{"children":"Bottles can oddly cost more in Japan than in the US, but bar and restaurant pours are much cheaper. Try Yamazaki, Hakushu, and Hibiki. Distillery tours use a lottery that requires applying months ahead."}],null]}]
1f:["$","li","Tsukiji Outer Market",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tsukiji Outer Market"}],null]}],["$","p",null,{"children":"Graze through the stalls at lunch. It occupies the old fish-market site, so the seafood is famously fresh."}],null]}]
20:["$","li","Ginza",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Ginza"}],["$","span",null,{"className":"guide-tag","children":"Optional"}]]}],["$","p",null,{"children":"Tokyo’s luxury shopping district; an easy time-saving skip if luxury shopping is not your thing."}],null]}]
21:["$","li","Akihabara",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Akihabara"}],["$","span",null,{"className":"guide-tag","children":"Optional"}]]}],["$","p",null,{"children":"A must for video-game or anime fans, and an easy skip for everyone else."}],null]}]
22:["$","li","Tokyo Tower",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tokyo Tower"}],null]}],["$","p",null,{"children":"Do not bother going up. See it from nearby and visit the lovely Zojo-ji temple."}],null]}]
23:["$","li","Tokyo Disney Resort",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tokyo Disney Resort"}],["$","span",null,{"className":"guide-tag","children":"Optional"}]]}],["$","p",null,{"children":"We have not visited, but it supposedly has some of the best Disney parks anywhere—especially DisneySea—if that is your thing."}],null]}]
24:["$","div",null,{"children":[["$","h3",null,{"className":"guide-subheading","children":"Where to eat · the must-gos"}],["$","p",null,{"className":"city-note","children":"Food quality is high almost everywhere, but a few high-end experiences truly stand out. These are those."}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Yoroniku Ebisu",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Yoroniku Ebisu"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Yakiniku (Japanese BBQ), and perhaps our single favorite restaurant in Japan. Choose the course with the gyukatsu sando. Reservations are required and semi-hard to get."}],["$","a",null,{"className":"guide-text-link","href":"https://omakase.in/en/r/yr300126","aria-label":"$undefined","children":["Book Yoroniku Ebisu"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","li","Hikiniku to Come",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Hikiniku to Come"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Must-go, very affordable hamburg steak. Reservations are required. Also in Kyoto if that suits your route better."}],["$","a",null,{"className":"guide-text-link","href":"https://www.tablecheck.com/shops/hikinikutocome/reserve","aria-label":"$undefined","children":["Book Hikiniku to Come"," ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","li","Kaiten Sushi Ginza Onodera",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Kaiten Sushi Ginza Onodera"}],["$","span",null,{"className":"guide-tag","children":"Walk-in"}]]}],["$","p",null,{"children":"The conveyor-belt offshoot of a famous Michelin-starred omakase house. If you do one kaiten sushi in Japan, make it this one. Walk-in. Also in Kyoto."}],null]}]]}],["$","h3",null,{"className":"guide-subheading guide-subheading--spaced","children":"Also excellent"}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Tonkatsu Narikura",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Tonkatsu Narikura"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"A fried-pork-cutlet course; reservations are required and hard to get."}],null]}],["$","li","Torisho Ishii Hina",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Torisho Ishii Hina"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Yakitori omakase; reservations are required and semi-hard to get."}],null]}],["$","li","Seirinkan",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Seirinkan"}],["$","span",null,{"className":"guide-tag","children":"Walk-in"}]]}],["$","p",null,{"children":"Famous Tokyo-style pizza honestly comparable with Rome. Walk-in, but expect a line."}],null]}],["$","li","Ginza Katsukami",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Ginza Katsukami"}],null]}],["$","p",null,{"children":"Another great tonkatsu course menu."}],null]}],["$","li","Bar Centifolia",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Bar Centifolia"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"The viral bartender’s wild cocktail performance is the point—and a great show. Reservations open 2–3 weeks ahead and disappear immediately."}],null]}]]}]]}]
25:["$","li","Rurikoin",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Rurikoin"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Polished tables beside corner windows reflect the garden like an infinity pool. Yes, it became an Instagram thing; it is still worth it. Peak fall requires advance tickets."}],null]}]
26:["$","li","Uji",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Uji"}],["$","span",null,{"className":"guide-tag","children":"Optional"}]]}],["$","p",null,{"children":"A scenic town south of Kyoto, supposedly matcha’s birthplace. Byodo-in is gorgeous and appears on the ¥10 coin, but this is probably not a first-visit priority unless something specific draws you."}],null]}]
27:["$","div",null,{"children":[["$","aside",null,{"className":"hotel-note","aria-labelledby":"hotel-title","children":[["$","p",null,{"className":"guide-kicker","children":"Where to stay"}],["$","h3",null,{"id":"hotel-title","children":"Park Hyatt Kyoto"}],["$","p",null,{"children":"We have stayed at many nice hotels, and this one is special enough to qualify as an attraction. It is very pricey, but worth a look if you feel like springing for it. Points people can transfer Chase or Bilt rewards to Hyatt."}]]}],["$","h3",null,{"className":"guide-subheading guide-subheading--spaced","children":"Where to eat"}],["$","ul",null,{"className":"tagged-list","children":[["$","li","Mouriya Gion",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Mouriya Gion"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"Kobe beef; reservation required."}],null]}],["$","li","Kaiten Sushi Ginza Onodera Kyoto",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Kaiten Sushi Ginza Onodera Kyoto"}],null]}],["$","p",null,{"children":"The same conveyor-belt standout recommended in Tokyo."}],null]}],["$","li","Sen no Kaze",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Sen no Kaze"}],["$","span",null,{"className":"guide-tag","children":"Walk-in"}]]}],["$","p",null,{"children":"Ramen; walk-in."}],null]}],["$","li","Hikiniku to Come Kyoto",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Hikiniku to Come Kyoto"}],null]}],["$","p",null,{"children":"The same must-go hamburg steak as in Tokyo."}],null]}],["$","li","Yusaitei",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h4",null,{"children":"Yusaitei"}],["$","span",null,{"className":"guide-tag","children":"Book ahead"}]]}],["$","p",null,{"children":"An izakaya-style assortment of great dishes in a fun atmosphere; reservation required."}],null]}]]}]]}]
28:["$","li","Winter · mid-December through February",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Winter · mid-December through February"}],null]}],["$","p",null,{"children":"Underrated and blissfully uncrowded. Main tourist areas remain fairly mild (40s–50s) and dry. There are no blossoms or foliage, but nearly everything else remains possible, plus snow monkeys, world-class Hokkaido skiing, and peak strawberry season."}],null]}]
29:["$","li","Summer",{"children":[["$","div",null,{"className":"tagged-list__heading","children":[["$","h3",null,{"children":"Summer"}],null]}],["$","p",null,{"children":"Every single person we have asked says the same thing: don’t. It is extremely hot and humid, with downpours that can wreck outdoor plans—and it intensifies every year."}],null]}]
