:HL["/assets/guide-fuji.webp?v=realistic-momiji","image",{"imageSrcSet":"/assets/guide-fuji-480.webp?v=realistic-momiji 480w, /assets/guide-fuji-960.webp?v=realistic-momiji 960w, /assets/guide-fuji.webp?v=realistic-momiji 1600w","imageSizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 32rem","fetchPriority":"high"}]
1:["$","div",null,{"className":"content-page","children":[["$","$L6",null,{"currentPath":"/guide"}],["$","main",null,{"id":"main-content","className":"content-page__main","children":[["$","$L7",null,{"items":[["november","November"],["plan","Plan"],["know","Know"],["transport","Transport"],["experiences","Experiences"],["eat","Eat"],["tokyo","Tokyo"],["kyoto","Kyoto"],["osaka","Osaka"],["more-japan","More Japan"]]}],["$","article",null,{"className":"guide-page","children":[["$","section",null,{"className":"guide-hero guide-section","id":"november","aria-labelledby":"guide-title","children":[["$","div",null,{"className":"guide-hero__copy","children":[["$","p",null,{"className":"guide-eyebrow","children":[["$","span",null,{"lang":"ja","children":"旅の案内"}]," · Guide to Japan"]}],["$","h1",null,{"id":"guide-title","children":"Japan in November"}],["$","p",null,{"className":"guide-lede","children":"Japan has so much to see that it is impossible to do everything in one visit. Find what pulls you in, do a little digging, and build the trip that fits your timeline. These are our honest, opinionated notes—take what is useful and ignore the rest."}]]}],["$","figure",null,{"className":"guide-photo guide-photo--hero","children":["$","img",null,{"src":"/assets/guide-fuji.webp?v=realistic-momiji","srcSet":"/assets/guide-fuji-480.webp?v=realistic-momiji 480w, /assets/guide-fuji-960.webp?v=realistic-momiji 960w, /assets/guide-fuji.webp?v=realistic-momiji 1600w","sizes":"(max-width: 42rem) calc(100vw - 2rem), (max-width: 74rem) 45vw, 32rem","width":1600,"height":1000,"alt":"Snow-capped Mount Fuji framed by vivid red and orange maple leaves across Lake Kawaguchiko.","loading":"eager","fetchPriority":"high","decoding":"async"}]}],["$","dl",null,{"className":"seasonal-strip","aria-label":"Japan in November at a glance","children":[["$","div","Weather",{"children":[["$","dt",null,{"children":"Weather"}],["$","dd",null,{"children":"Crisp 50s–low 60s; 40s mornings and evenings"}]]}],["$","div","Sunset",{"children":[["$","dt",null,{"children":"Sunset"}],["$","dd",null,{"children":"Around 4:30–4:45pm"}]]}],["$","div","Koyo",{"children":[["$","dt",null,{"children":"Koyo"}],["$","dd",null,{"children":"Peak fall-color season"}]]}],["$","div","Mt. Fuji",{"children":[["$","dt",null,{"children":"Mt. Fuji"}],["$","dd",null,{"children":"Some of the clearest views of the year"}]]}]]}],["$","div",null,{"className":"guide-november-copy guide-reading-width","children":[["$","h2",null,{"children":"Why November works"}],["$","p",null,{"children":"Japan is deeply seasonal: the culture appreciates each season instead of forcing seasonal foods into year-round availability. November is among the driest, clearest, most comfortable months. Expect blue-sky days in the 50s and low 60s °F, mornings and evenings in the 40s, and layers plus a light jacket rather than a heavy coat."}],["$","p",null,{"children":["You are arriving in peak ",["$","i",null,{"children":"koyo"}],". The fall colors are more vivid than anything we have seen in the US, while cold, dry air brings some of the clearest Mt. Fuji views of the year."]}]]}],["$","figure",null,{"className":"daylight-figure","children":[["$","div",null,{"className":"daylight-arc","aria-hidden":"true","children":[["$","span",null,{"children":"Morning"}],["$","span",null,{"children":"4:30–4:45pm"}],["$","span",null,{"children":"Night"}]]}],["$","figcaption",null,{"children":[["$","strong",null,{"children":"Follow the November light."}]," Plan outdoor sightseeing for mornings and early afternoons. After the 4:30–4:45pm sunset, switch to dinner, neon-lit neighborhoods, and winter illuminations, which begin appearing across the country in mid-November."]}]]}],["$","div",null,{"className":"foliage-table-wrap","children":["$","table",null,{"className":"foliage-table","children":[["$","caption",null,{"children":"Typical fall-color timing on the likely route"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Where"}],["$","th",null,{"scope":"col","children":"Note"}],["$","th",null,{"scope":"col","children":"Usual peak"}]]}]}],["$","tbody",null,{"children":[["$","tr","Tokyo",{"children":[["$","th",null,{"scope":"row","children":"Tokyo"}],"$L8","$L9"]}],"$La","$Lb","$Lc"]}]]}]}],"$Ld"]}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16"]}]]}],"$L17"]}]
