1:["$","div",null,{"className":"content-page","children":[["$","$L6",null,{"currentPath":"/faq"}],["$","main",null,{"id":"main-content","tabIndex":-1,"className":"content-page__main","children":["$undefined",["$","section",null,{"className":"faq-page","aria-labelledby":"faq-title","children":[["$","header",null,{"className":"faq-intro","children":[["$","p",null,{"className":"faq-eyebrow","children":"The wedding weekend"}],["$","h1",null,{"id":"faq-title","children":"Frequently asked questions"}],["$","p",null,{"children":"What to wear, what to expect, and how to get there."}]]}],["$","div",null,{"className":"faq-list","children":[["$","details","dress-code",{"className":"faq-item","id":"dress-code","open":true,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"What is the dress code for the wedding?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","For the wedding, we’d love to see you in suits with ties for men and dresses for women. We’re going for a fall color theme (shades of yellow, red, orange, and brown). Feel free to incorporate that into your wear however you see fit. We want you to be comfortable and enjoy the day more than anything.",{"children":"For the wedding, we’d love to see you in suits with ties for men and dresses for women. We’re going for a fall color theme (shades of yellow, red, orange, and brown). Feel free to incorporate that into your wear however you see fit. We want you to be comfortable and enjoy the day more than anything."}],["$","p","For women, the ground at the wedding venue is a field and not even at all places. We recommend against wearing pointed heels. Think block heels or flats.",{"children":"For women, the ground at the wedding venue is a field and not even at all places. We recommend against wearing pointed heels. Think block heels or flats."}],["$","p","For the welcome dinner, we will be going to a local izakaya and that will be a smart casual dress code.",{"children":"For the welcome dinner, we will be going to a local izakaya and that will be a smart casual dress code."}]],null]}]]}],["$","details","weather",{"className":"faq-item","id":"weather","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"What is the weather going to be like?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","The wedding ceremony and reception will be completely outdoors. You can expect temperatures to range from 55-65 ºF during the mid part of the day while we’re there. November in Japan is known for mild/warm temperatures with clear sunny skies. That’s what we’re hoping for and banking on given an analysis of 15 years of historical weather data.",{"children":"The wedding ceremony and reception will be completely outdoors. You can expect temperatures to range from 55-65 ºF during the mid part of the day while we’re there. November in Japan is known for mild/warm temperatures with clear sunny skies. That’s what we’re hoping for and banking on given an analysis of 15 years of historical weather data."}],["$","p","That being said, anything can happen. If you are someone who tends to get chilly, please be prepared to pack and wear layers so you’re comfortable if we get a less favorable day. The wedding venue is a 40 minute drive from the hotel so you likely won’t have an opportunity to go back and change if needed.",{"children":"That being said, anything can happen. If you are someone who tends to get chilly, please be prepared to pack and wear layers so you’re comfortable if we get a less favorable day. The wedding venue is a 40 minute drive from the hotel so you likely won’t have an opportunity to go back and change if needed."}],"$L7","$L8"],null]}]]}],"$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10"]}]]}]]}],"$L11"]}]
12:I["c2747888630f",[],"default",1]
7:["$","p","We will have a tent with some heating that can accommodate everyone for seating and eating, but you will be moving in and out of the tent throughout the event.",{"children":"We will have a tent with some heating that can accommodate everyone for seating and eating, but you will be moving in and out of the tent throughout the event."}]
8:["$","p","We will keep everyone updated as we get closer to the event on what to prepare for and if it’s looking like a warmer or cooler day than expected.",{"children":"We will keep everyone updated as we get closer to the event on what to prepare for and if it’s looking like a warmer or cooler day than expected."}]
9:["$","details","traditions",{"className":"faq-item","id":"traditions","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"Does the wedding have any Japanese traditional or religious elements that I need to know about?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","No. There are several reasons why we chose to have our wedding in Japan but religion/traditions is not one of them. Instead, our desire is to share why we love Japan throughout the weekend.",{"children":"No. There are several reasons why we chose to have our wedding in Japan but religion/traditions is not one of them. Instead, our desire is to share why we love Japan throughout the weekend."}]],null]}]]}]
a:["$","details","onsen",{"className":"faq-item","id":"onsen","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"I noticed the guys are going to the onsen (hot springs) on Friday night. What are the girls doing during that time?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","After the welcome dinner on Friday evening, Justin will be hosting his bachelor party at a local onsen. This is a naturally gender-separated activity because guests are required to be completely nude in the hot spring.",{"children":"After the welcome dinner on Friday evening, Justin will be hosting his bachelor party at a local onsen. This is a naturally gender-separated activity because guests are required to be completely nude in the hot spring."}],["$","p","At this time, Aya isn’t planning a similar “guided experience” for women. We do want everyone to know that there is a women’s section at the same location and all women guests are welcomed to go at the same time as the men.",{"children":"At this time, Aya isn’t planning a similar “guided experience” for women. We do want everyone to know that there is a women’s section at the same location and all women guests are welcomed to go at the same time as the men."}],["$","p","One thing to note is that the onsen attached to our hotel is unfortunately under renovation with an unknown date of completion. We are currently planning to go to another nearby onsen instead unless the hotel gives us more information. Therefore, going on Friday evening may be your only chance to experience a public onsen in Japan unless you have something else planned during your trip. We encourage you to take advantage!",{"children":"One thing to note is that the onsen attached to our hotel is unfortunately under renovation with an unknown date of completion. We are currently planning to go to another nearby onsen instead unless the hotel gives us more information. Therefore, going on Friday evening may be your only chance to experience a public onsen in Japan unless you have something else planned during your trip. We encourage you to take advantage!"}]],null]}]]}]
b:["$","details","getting-there",{"className":"faq-item","id":"getting-there","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"How do I get to the wedding?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","For those of you who are traveling internationally, we strongly encourage you to join us on our arranged bus from Tokyo Station to the wedding hotel on Friday afternoon. We’re happy that the vast majority of you are planning to do that.",{"children":"For those of you who are traveling internationally, we strongly encourage you to join us on our arranged bus from Tokyo Station to the wedding hotel on Friday afternoon. We’re happy that the vast majority of you are planning to do that."}],["$","p","For the select few of you that are arriving from other parts of Japan, we will make sure you have accurate and timely directions far in advance.",{"children":"For the select few of you that are arriving from other parts of Japan, we will make sure you have accurate and timely directions far in advance."}]],null]}]]}]
c:["$","details","heading-home",{"className":"faq-item","id":"heading-home","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"When will wedding events be completed and how do I get back to Tokyo or my next Japan destination after the wedding?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","On Sunday late morning, we plan to take everyone to a local autumn festival to have an opportunity to see Japan’s stunning fall foliage that lines nearby Lake Kawaguchiko. There will also be local food that you can try.",{"children":"On Sunday late morning, we plan to take everyone to a local autumn festival to have an opportunity to see Japan’s stunning fall foliage that lines nearby Lake Kawaguchiko. There will also be local food that you can try."}],["$","p","Since most international travelers are going back to Tokyo after the wedding, we are planning to get everyone back to the hotel in time to catch a 1:48 or 2:00 PM public bus back to Tokyo that leaves directly from the hotel lobby. This will get you back to Tokyo around 4 PM.",{"children":"Since most international travelers are going back to Tokyo after the wedding, we are planning to get everyone back to the hotel in time to catch a 1:48 or 2:00 PM public bus back to Tokyo that leaves directly from the hotel lobby. This will get you back to Tokyo around 4 PM."}],["$","p","For those of you who will be off to other destinations in Japan, we will make sure you know where to go in advance.",{"children":"For those of you who will be off to other destinations in Japan, we will make sure you know where to go in advance."}]],null]}]]}]
d:["$","details","breakfast",{"className":"faq-item","id":"breakfast","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"Does the wedding hotel include breakfast?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","Yes.",{"children":"Yes."}]],null]}]]}]
e:["$","details","hotel-payment",{"className":"faq-item","id":"hotel-payment","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"When do I pay for the hotel?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","At the time of stay.",{"children":"At the time of stay."}]],null]}]]}]
f:["$","details","gifts",{"className":"faq-item","id":"gifts","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"Should we bring a wedding gift?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","Your presence and participation is all that we could ever ask for.",{"children":"Your presence and participation is all that we could ever ask for."}]],null]}]]}]
10:["$","details","exploring-japan",{"className":"faq-item","id":"exploring-japan","open":false,"children":[["$","summary",null,{"children":[["$","h2",null,{"children":"What else should I do while I’m in Japan?"}],["$","span",null,{"className":"faq-item__indicator","aria-hidden":"true"}]]}],["$","div",null,{"className":"faq-answer","children":[[["$","p","Great question! We’ve prepared a pretty extensive guide on what we recommend. We are happy to help you on an individual basis as you make bookings or need help deciding on certain things. Planning in Japan can be challenging so please feel free use us as a resource.",{"children":"Great question! We’ve prepared a pretty extensive guide on what we recommend. We are happy to help you on an individual basis as you make bookings or need help deciding on certain things. Planning in Japan can be challenging so please feel free use us as a resource."}]],["$","p",null,{"className":"faq-answer__link","children":["$","$L12",null,{"href":"/guide","children":["Read our Guide to Japan"," ",["$","span",null,{"aria-hidden":"true","children":"→"}]]}]}]]}]]}]
11:["$","footer",null,{"className":"site-footer","children":["$","div",null,{"className":"site-footer__inner","children":[["$","p",null,{"children":[["$","time",null,{"dateTime":"2026-11-13","children":"November 13"}],"–",["$","time",null,{"dateTime":"2026-11-15","children":"15, 2026"}]," · Yamanashi, Japan"]}],["$","nav",null,{"aria-label":"Footer navigation","children":["$","ul",null,{"children":[["$","li","/",{"children":["$","a",null,{"href":"/","aria-current":"$undefined","children":"Home"}]}],["$","li","/schedule",{"children":["$","a",null,{"href":"/schedule","aria-current":"$undefined","children":"Schedule"}]}],["$","li","/guide",{"children":["$","a",null,{"href":"/guide","aria-current":"$undefined","children":"Guide to Japan"}]}],["$","li","/faq",{"children":["$","a",null,{"href":"/faq","aria-current":"page","children":"FAQ"}]}],["$","li","/registry",{"children":["$","a",null,{"href":"/registry","aria-current":"$undefined","children":"Registry"}]}],["$","li","/rsvp",{"children":["$","a",null,{"href":"/rsvp","aria-current":"$undefined","children":"RSVP"}]}]]}]}]]}]}]
