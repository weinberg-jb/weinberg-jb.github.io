, transportation, the hotel, and celebrating in Japan."}],["$","meta","16",{"name":"twitter:image","content":"https://ayatojb.jp/assets/wedding-share-de2f9341.jpg"}],["$","meta","17",{"name":"twitter:image:alt","content":"Hand-drawn wedding artwork of Aya and Justin beneath Mt Fuji with autumn foliage."}],["$","link","18",{"rel":"icon","href":"https://ayatojb.jp/favicon.ico","sizes":"16x16 32x32 48x48","type":"image/vnd.microsoft.icon"}],["$","link","19",{"rel":"icon","href":"https://ayatojb.jp/icon-192.png","sizes":"192x192","type":"image/png"}],["$","link","20",{"rel":"apple-touch-icon","href":"https://ayatojb.jp/apple-touch-icon.png","sizes":"180x180","type":"image/png"}],["$","link","21",{"rel":"canonical","href":"https://ayatojb.jp/faq"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"name":"theme-color","content":"#f6ede9"}],["$","meta","2",{"name":"color-scheme","content":"light"}]]],["$","$L3",null,{"segmentMap":{"children":["faq"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/faq"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1dnurvz1tr05fo","deploymentVersion":"e00e6393-c7d0-4f7f-be43-dccae921b875","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
